<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Product>ChromaDB.Testcontainers</Product>
    <Copyright>Copyright (c) 2019 - 2026 Andre Hofmeister and other authors. Copyright (c) 2026 ChromaDotNet contributors.</Copyright>
    <Authors>ChromaDotNet contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/ChromaDotNet/ChromaDB.Testcontainers</PackageProjectUrl>
    <!-- The notes link the GitHub release of the version, so they follow every release. -->
    <PackageReleaseNotes>Release notes: $(PackageProjectUrl)/releases/tag/v$(VersionPrefix)</PackageReleaseNotes>
    <PackageTags>chroma;chromadb;docker;dotnet;testcontainers;testing;vector-database</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ChromaDotNet/ChromaDB.Testcontainers</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <!-- In GitHub Actions the build maps the source paths, so that the assemblies of the package are deterministic: the
       same commit gives the same assemblies. -->
  <PropertyGroup Condition=" '$(GITHUB_ACTIONS)' == 'true' ">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>CA1859,CA1861,CS0618,CS1591,xUnit1044,xUnit1045</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="SauceControl.InheritDoc" VersionOverride="2.0.2"/>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Visible="false" Pack="true" PackagePath=""/>
    <None Include="$(MSBuildThisFileDirectory)README.md" Visible="false" Pack="true" PackagePath=""/>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Visible="false" Pack="true" PackagePath=""/>
  </ItemGroup>
</Project>
